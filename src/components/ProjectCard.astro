---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  // h2 when the list sits directly under the page's h1
  as?: "h2" | "h3";
}

const { project, as: Heading = "h3" } = Astro.props;
const { data } = project;
---

<article class="entry py-10 first:pt-0">
  <div class="group relative max-w-2xl">
    <Heading class="text-2xl font-semibold tracking-[-0.015em]">
      <a
        href={`/projects/${project.id}`}
        class="after:absolute after:inset-0 group-hover:text-accent transition-colors"
      >
        {data.title}
      </a>
    </Heading>
    <p class="mt-1 text-base text-muted">{data.subtitle}</p>
    <p class="mt-4 font-serif text-lg leading-relaxed">{data.description}</p>
  </div>

  <dl class="meta">
    <div>
      <dt>Status</dt>
      <dd>{data.inProgress ? "In progress" : data.year}</dd>
    </div>
    <div>
      <dt>Topics</dt>
      <dd>{data.tags.join(", ")}</dd>
    </div>
    {
      data.links.map((l) => (
        <div>
          <a href={l.href} class="button button-small">{l.label}</a>
        </div>
      ))
    }
  </dl>
</article>

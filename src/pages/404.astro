---
import Base from "../layouts/Base.astro";
---

<Base title="Not found — Michał Wysocki">
  <section class="mx-auto max-w-5xl px-6 py-32">
    <h1 class="text-4xl font-semibold tracking-[-0.025em]">Not found</h1>

    <p class="mt-4 font-serif text-lg text-muted">
      This page doesn't exist, or it moved.
    </p>

    <p class="mt-8">
      <a href="/" class="button">Back to home</a>
    </p>
  </section>
</Base>

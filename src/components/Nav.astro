---
const links = [
  { label: "Projects", href: "/projects" },
  { label: "CV", href: "/cv" },
  { label: "About", href: "/about" },
];

const path = Astro.url.pathname;
---

<nav class="mx-auto flex max-w-5xl items-baseline justify-between px-6 py-7">
  <a href="/" class="text-base font-semibold tracking-[-0.01em]">Michał Wysocki</a>

  <div class="flex gap-6 text-base">
    {
      links.map((l) => (
        <a
          href={l.href}
          aria-current={path.startsWith(l.href) ? "page" : undefined}
          class:list={[
            "transition-colors hover:text-accent",
            path.startsWith(l.href) ? "text-accent" : "text-muted",
          ]}
        >
          {l.label}
        </a>
      ))
    }
  </div>
</nav>

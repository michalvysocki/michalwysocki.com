---
import { achievements } from "../data/achievements";
import Section from "./Section.astro";

interface Props {
  // Show only the newest few, with a link to the full list on the About page.
  limit?: number;
}

const { limit } = Astro.props;

const shown = achievements
  .toSorted((a, b) => b.year - a.year)
  .slice(0, limit);
---

<Section title="Achievements" id="achievements">
  {
    shown.map((a) => (
      <article class="entry py-8 first:pt-0 last:pb-0">
        <div class="max-w-2xl">
          <h3 class="text-lg font-semibold tracking-[-0.01em]">{a.event}</h3>
          <p class="mt-2 font-serif text-lg leading-relaxed">{a.summary}</p>
        </div>
        <dl class="meta">
          <div>
            <dt>Result</dt>
            <dd class="text-accent">{a.result}</dd>
          </div>
          <div>
            <dt>Year</dt>
            <dd>{a.year}</dd>
          </div>
        </dl>
      </article>
    ))
  }

  {limit && limit < achievements.length && (
    <p class="mt-4">
      <a href="/about#achievements" class="button">All achievements</a>
    </p>
  )}
</Section>

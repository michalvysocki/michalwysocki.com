---
import { experience } from "../data/experience";
import Section from "./Section.astro";
---

<Section title="Experience" as="h1">
  <ol class="relative border-l border-line">
    {
      experience.map((r) => (
        <li class="entry relative gap-y-1 pb-10 pl-7 last:pb-0 lg:gap-y-5">
          <span
            class:list={[
              "absolute top-2 -left-[5px] size-[9px] rounded-full border",
              r.current ? "border-accent bg-accent" : "border-muted bg-bg",
            ]}
            aria-hidden="true"
          />
          <div class="max-w-2xl">
            <h2 class="text-lg font-semibold tracking-[-0.01em]">{r.title}</h2>
            <p class="text-base text-muted">{r.org}</p>
            <p class="mt-2 font-serif text-lg leading-relaxed">{r.summary}</p>
          </div>
          <dl class="meta order-first lg:order-none">
            <div>
              <dt class="sr-only">Period</dt>
              <dd class="text-muted lg:text-fg">{r.period}</dd>
            </div>
          </dl>
        </li>
      ))
    }
  </ol>
</Section>

---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---

<Base title={`${data.title} — Michał Wysocki`} description={data.description}>
  <article class="entry mx-auto max-w-5xl px-6 pt-12 pb-16">
    <div class="min-w-0">
      <h1 class="text-4xl font-semibold tracking-[-0.025em] sm:text-5xl">{data.title}</h1>
      <p class="mt-3 font-serif text-xl text-muted">{data.subtitle}</p>

      <div class="prose mt-10">
        <Content />
      </div>
    </div>

    <dl class="meta order-first mt-2 lg:order-none lg:sticky lg:top-8 lg:self-start lg:pt-3">
      <div>
        <dt>Status</dt>
        <dd>{data.inProgress ? "In progress" : data.year}</dd>
      </div>
      <div>
        <dt>Topics</dt>
        <dd>{data.tags.join(", ")}</dd>
      </div>
      {
        data.links.map((l) => (
          <div>
            <a href={l.href} class="button button-small">{l.label}</a>
          </div>
        ))
      }
    </dl>
  </article>
</Base>

---
const links = [
  { label: "Email", href: "mailto:michalwysocki.priv@proton.me", primary: true },
  { label: "GitHub", href: "https://github.com/michalvysocki" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/michalvysocki/" },
];

const year = new Date().getFullYear();
---

<footer class="mt-16 bg-fg text-bg">
  <div class="mx-auto max-w-5xl px-6 pt-16 pb-12 sm:pt-20">
    <h2 class="text-2xl font-semibold tracking-[-0.02em] sm:text-3xl">Get in touch</h2>

    <p class="mt-4 font-serif text-lg text-inverse-muted">
      For research, engineering, or interesting problems.
    </p>

    <p class="mt-8 flex flex-wrap gap-3">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              "button",
              l.primary
                ? "border-inverse-accent text-inverse-accent hover:bg-inverse-accent hover:text-fg"
                : "border-bg/50 text-bg hover:bg-bg hover:text-fg",
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </p>

    <p class="mt-16 text-sm text-inverse-muted">© {year} Michał Wysocki</p>
  </div>
</footer>

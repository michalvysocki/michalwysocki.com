---
import { education } from "../data/education";
import Section from "./Section.astro";
---

<Section title="Education">
  {
    education.map((s) => (
      <article class="entry py-8 first:pt-0 last:pb-0">
        <div class="max-w-2xl">
          <h3 class="text-lg font-semibold tracking-[-0.01em]">{s.field}</h3>
          <p class="text-base text-muted">
            {s.degree}, {s.institution}
          </p>
        </div>
        <dl class="meta">
          <div>
            <dt>Period</dt>
            <dd>{s.period}</dd>
          </div>
        </dl>
      </article>
    ))
  }
</Section>
